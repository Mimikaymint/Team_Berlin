        "# 1.3.4 link to how it was classified: https://www.cdc.gov/nchs/hus/sources-definitions/msa.htm\n",
        "# Hypothesis : classified into binary (Urban & Rural) where MSA Principle City and MSA Not Principle city are Urban and Non-MSA is rural\n",
        "def classify_urban_rural(x):\n",
        "    if x == 'Non-MSA':\n",
        "        return 'Rural'\n",
        "    else:  \n",
        "        return 'Urban'\n",
        "\n",
        "flu_df['census_msa'] = flu_df['census_msa'].apply(classify_urban_rural)\n",
        "\n",
        "flu_df['census_msa'].value_counts()\n"
      ]
